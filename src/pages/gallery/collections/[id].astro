---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import ArtworkCard from '../../../components/ArtworkCard.astro';
import ArtworkViewer from '../../../components/ArtworkViewer.astro';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { withBase } from '../../../utils';

export async function getStaticPaths() {
	const collections = await getCollection('collections');
	const gallery = await getCollection('gallery');
	return collections.map((entry) => ({
		params: { id: entry.id },
		props: {
			entry,
			items: gallery
				.filter((item) => item.data.collection?.id === entry.id)
				.sort((a, b) => b.data.year - a.data.year || a.data.name.localeCompare(b.data.name)),
		},
	}));
}

const { entry, items } = Astro.props;
const { name, summary, image, imageAlt } = entry.data;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${name} | ${SITE_TITLE}`} description={summary} image={image} />
	</head>
	<body>
		<Header />
		<main class="w-[1100px]! py-12!">
			<a href={withBase('/gallery')} class="text-base">&larr; Gallery</a>
			<article class="mt-6 flex flex-col gap-8 md:flex-row md:items-start md:gap-12">
				<Image
					src={image}
					alt={imageAlt ?? name}
					loading="eager"
					fetchpriority="high"
					width={1100}
					class="h-auto w-full rounded-xl shadow-[var(--box-shadow)] md:w-1/2"
				/>
				<div class="min-w-0 flex-1">
					<p class="m-0 text-sm font-bold tracking-widest text-[rgb(var(--gray))] uppercase">Collection</p>
					<h1 class="font-title mt-1 mb-4 text-5xl font-bold">{name}</h1>
					<div class="[&>p]:m-0 [&>p]:mb-4 [&>p:last-child]:mb-0">
						<Content />
					</div>
				</div>
			</article>
			{
				items.length > 0 && (
					<section class="mt-12">
						<h2 class="mb-4! text-sm! font-bold tracking-widest text-[rgb(var(--gray))] uppercase">In this collection</h2>
						<ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-6 p-0">
							{items.map((item) => (
								<li>
									<ArtworkCard item={item} showCollection={false} />
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<ArtworkViewer />
		<Footer />
	</body>
</html>
