---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const entry = (await getEntry('about', 'about'))!;
const { heading, photo, photoAlt } = entry.data;
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About Katie Rayson, artist." />
	</head>
	<body>
		<Header />
		<main class="w-[960px]! py-12!">
			<section class="flex flex-col items-center gap-8 md:flex-row md:items-start md:gap-12">
				<Image
					src={photo}
					alt={photoAlt}
					loading="eager"
					fetchpriority="high"
					width={150}
					height={150}
					class="size-44 shrink-0 rounded-full! object-cover shadow-[var(--box-shadow)] ring-4 ring-white"
				/>
				<div class="text-center md:text-left">
					<p class="m-0 text-sm font-bold tracking-widest text-[rgb(var(--gray))] uppercase">About</p>
					<h1 class="font-title mt-1 mb-4 text-5xl font-bold">{heading}</h1>
					<div class="[&>p]:m-0 [&>p]:mb-4 [&>p:last-child]:mb-0">
						<Content />
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
