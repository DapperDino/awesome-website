---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils';

const { tiles } = (await getEntry('home', 'home'))!.data;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="w-full! max-w-none! px-4!">
			<div class="grid grid-cols-3 gap-4">
				{
					tiles.map((tile) => (
						<a href={withBase('/gallery')} class="group relative block overflow-hidden rounded-xl">
							<Image
								src={tile.image}
								width={640}
								height={480}
								alt={tile.label}
								class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-105"
							/>
							<span class="absolute inset-0 flex items-center justify-center bg-black/30 font-title text-4xl font-bold text-white">
								{tile.label}
							</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
