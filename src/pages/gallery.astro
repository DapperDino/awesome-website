---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import BaseHead from '../components/BaseHead.astro';
import CollectionCarousel from '../components/CollectionCarousel.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';

const items = (await getCollection('gallery')).sort(
	(a, b) => b.data.year - a.data.year || a.data.name.localeCompare(b.data.name),
);

const collections = (await getCollection('collections')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const counts = Object.fromEntries(
	collections.map((c) => [c.id, items.filter((item) => item.data.collection?.id === c.id).length]),
);

const norm = (m: string) => m.trim().toLowerCase();
const tagsOf = (list?: string[]) => (list ?? []).map(norm);
const unique = (key: 'mediums' | 'themes') =>
	[...new Set(items.flatMap((item) => tagsOf(item.data[key])))].sort();

const groups = [
	{ key: 'mediums', label: 'Medium', values: unique('mediums') },
	{ key: 'themes', label: 'Theme', values: unique('themes') },
].filter((g) => g.values.length > 0);

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Gallery | ${SITE_TITLE}`} description="A gallery of my artwork." />
	</head>
	<body>
		<Header />
		<main class="w-[1100px]! pt-6!">
			<h1 class="font-title mb-6! text-5xl font-bold">Gallery</h1>
			{
				collections.length > 0 && (
					<section aria-labelledby="collections-heading">
						<h2 id="collections-heading" class="mb-4! text-sm! font-bold tracking-widest text-[rgb(var(--gray))] uppercase">Collections</h2>
						<CollectionCarousel collections={collections} counts={counts} />
						<hr class="my-10 border-t-2 border-[rgb(var(--gray-light))]" />
					</section>
				)
			}
			<h2 id="all-pieces" class="mb-4! scroll-mt-6 text-sm! font-bold tracking-widest text-[rgb(var(--gray))] uppercase">All pieces</h2>
			<div class="flex flex-col gap-6 md:flex-row md:items-start md:gap-10">
			<aside class="flex flex-col gap-5 md:sticky md:top-6 md:w-52 md:shrink-0">
						{groups.map((group) => (
							<div class="flex flex-wrap items-center gap-2" role="group" aria-label={`Filter by ${group.label.toLowerCase()}`}>
								<span class="w-full text-sm font-bold tracking-widest text-[rgb(var(--gray))] uppercase">{group.label}</span>
								{['all', ...group.values].map((v) => (
									<button
										type="button"
										data-group={group.key}
										data-filter={v}
										aria-pressed={v === 'all' ? 'true' : 'false'}
										class="cursor-pointer rounded-full border border-[rgb(var(--gray-light))] bg-white px-4 py-1 text-base capitalize text-[rgb(var(--gray-dark))] transition-colors hover:bg-[rgb(var(--gray-light))] aria-pressed:border-[rgb(var(--gray-dark))] aria-pressed:bg-[rgb(var(--gray-dark))] aria-pressed:text-white"
									>
										{v}
									</button>
								))}
							</div>
						))}
			</aside>
			<div class="min-w-0 flex-1">
			<ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-6 p-0">
				{
					items.map((item) => (
						<li data-item data-mediums={tagsOf(item.data.mediums).join(',')} data-themes={tagsOf(item.data.themes).join(',')}>
							<ArtworkCard item={item} />
						</li>
					))
				}
			</ul>
			<p id="no-results" hidden class="text-[rgb(var(--gray))]">No artworks match all of the selected filters.</p>
			</div>
			</div>
		</main>
		<ArtworkViewer />
		<Footer />
	</body>
</html>


<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const emptyMessage = document.querySelector<HTMLElement>('#no-results');
	const selected: Record<string, Set<string>> = {};

	function applyFilter() {
		filterButtons.forEach((b) => {
			const chosen = selected[b.dataset.group!] ?? new Set();
			const filter = b.dataset.filter!;
			b.setAttribute('aria-pressed', String(filter === 'all' ? chosen.size === 0 : chosen.has(filter)));
		});
		let visible = 0;
		document.querySelectorAll<HTMLElement>('[data-item]').forEach((li) => {
			li.hidden = !Object.entries(selected).every(([group, chosen]) => {
				const tags = (li.dataset[group] ?? '').split(',');
				return [...chosen].every((value) => tags.includes(value));
			});
			if (!li.hidden) visible++;
		});
		if (emptyMessage) emptyMessage.hidden = visible > 0;
	}

	const params = new URLSearchParams(location.search);
	filterButtons.forEach((b) => {
		const group = b.dataset.group!;
		const wanted = (params.get(group) ?? '').toLowerCase().split(',');
		if (wanted.includes(b.dataset.filter!)) (selected[group] ??= new Set()).add(b.dataset.filter!);
	});
	applyFilter();
	if (Object.values(selected).some((chosen) => chosen.size > 0) && !location.hash) {
		document.getElementById('all-pieces')?.scrollIntoView();
	}

	filterButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const group = button.dataset.group!;
			const filter = button.dataset.filter!;
			const chosen = (selected[group] ??= new Set());
			if (filter === 'all') chosen.clear();
			else if (chosen.has(filter)) chosen.delete(filter);
			else chosen.add(filter);
			applyFilter();
		});
	});

</script>
