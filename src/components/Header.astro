---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils';
import HeaderLink from './HeaderLink.astro';
---

<header class="m-0 bg-white px-4 shadow-[0_2px_8px_rgba(var(--black),5%)]">
	<nav class="relative flex items-center justify-between">
		<h2 class="m-0! font-title text-3xl! font-bold"><a href={withBase('/')} class="px-2 py-4 text-[rgb(var(--black))]! no-underline">{SITE_TITLE}</a></h2>
		<button
			type="button"
			id="menu-toggle"
			class="flex size-10 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent min-[721px]:hidden"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="menu"
		>
			<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 6h16M4 12h16M4 18h16"></path>
			</svg>
		</button>
		<div
			id="menu"
			class="absolute top-full right-0 left-0 z-10 hidden flex-col bg-white px-2 pb-2 shadow-[0_8px_8px_rgba(var(--black),8%)] min-[721px]:contents"
		>
		<div class="internal-links flex flex-col min-[721px]:flex-row">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/gallery">Gallery</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="flex">
			<a href="https://www.instagram.com/katie.rayson.art/" target="_blank" class="flex px-2 py-4">
				<span class="sr-only">Follow me on Instagram</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"><defs><linearGradient id="ig-gradient-h" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#feda75"/><stop offset=".3" stop-color="#fa7e1e"/><stop offset=".55" stop-color="#d62976"/><stop offset=".8" stop-color="#962fbf"/><stop offset="1" stop-color="#4f5bd5"/></linearGradient></defs><path
						fill="url(#ig-gradient-h)"
						d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"
					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/katie-rayson-art/" target="_blank" class="flex px-2 py-4">
				<span class="sr-only">Check out my LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="#0A66C2"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path></svg
				>
			</a>
		</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
	const menu = document.querySelector<HTMLElement>('#menu')!;

	function setOpen(open: boolean) {
		menu.classList.toggle('hidden', !open);
		menu.classList.toggle('flex', open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
	// Reset when growing to desktop so the menu isn't left in an open state.
	window.matchMedia('(min-width: 721px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
