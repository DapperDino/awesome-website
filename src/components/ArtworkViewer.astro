---
import { SITE_TITLE } from '../consts';
---

<dialog
	id="viewer"
	aria-labelledby="viewer-name"
	class="m-auto max-h-[94vh] w-[min(94vw,1100px)] overflow-auto overscroll-contain rounded-none border-0 bg-[#f4f1ea] p-5 shadow-[var(--box-shadow)] backdrop:bg-black/80 md:p-10"
>
	<button
		type="button"
		class="close absolute top-3 right-3 size-9 cursor-pointer rounded-full border-0 bg-transparent text-3xl leading-none text-[rgb(var(--gray-dark))] hover:bg-black/10"
		aria-label="Close"
	>&times;</button>
	<div class="flex flex-col gap-8 md:flex-row md:items-end md:gap-10">
		<div class="viewer-image flex min-w-0 flex-1 justify-center bg-white p-3 shadow-[0_6px_24px_rgba(0,0,0,0.18)] md:p-5"></div>
		<div class="border border-neutral-300 bg-white p-5 font-serif text-[rgb(var(--gray-dark))] shadow-sm md:w-64 md:shrink-0">
			<p class="m-0 text-xs tracking-[0.25em] uppercase">{SITE_TITLE}</p>
			<h2 id="viewer-name" class="mt-3! mb-0! font-serif text-2xl! font-normal italic"></h2>
			<p class="viewer-year m-0 mt-1 text-base"></p>
			<p class="viewer-mediums m-0 mt-3 text-sm capitalize"></p>
			<hr class="my-4 border-0 border-t border-neutral-300" />
			<p class="viewer-description m-0 text-sm leading-relaxed"></p>
			<p class="viewer-collection m-0 mt-3 text-sm">Part of <a class="text-[var(--accent-dark)]"></a></p>
		<p class="viewer-themes m-0 mt-4 text-xs tracking-wide text-[rgb(var(--gray))] capitalize italic"></p>
		</div>
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('#viewer')!;
	const imageBox = dialog.querySelector('.viewer-image')!;
	const nameEl = dialog.querySelector('#viewer-name')!;
	const yearEl = dialog.querySelector('.viewer-year')!;
	const mediumsEl = dialog.querySelector<HTMLElement>('.viewer-mediums')!;
	const themesEl = dialog.querySelector<HTMLElement>('.viewer-themes')!;
	const collectionEl = dialog.querySelector<HTMLElement>('.viewer-collection')!;
	const collectionLink = collectionEl.querySelector('a')!;
	const descEl = dialog.querySelector('.viewer-description')!;

	document.querySelectorAll<HTMLButtonElement>('[data-card]').forEach((card) => {
		card.addEventListener('click', () => {
			const template = card.parentElement!.querySelector('template')!;
			imageBox.replaceChildren(template.content.cloneNode(true));
			nameEl.textContent = card.dataset.name ?? '';
			yearEl.textContent = card.dataset.year ?? '';
			const fill = (el: HTMLElement, csv: string | undefined, prefix = '') => {
				const text = (csv ?? '').split(',').filter(Boolean).join(', ');
				el.textContent = text ? prefix + text : '';
				el.hidden = !text;
			};
			fill(mediumsEl, card.dataset.mediums);
			fill(themesEl, card.dataset.themes, 'Themes: ');
			const collectionHref = card.dataset.collectionHref;
			collectionEl.hidden = !collectionHref;
			if (collectionHref) {
				collectionLink.href = collectionHref;
				collectionLink.textContent = card.dataset.collectionName ?? '';
			}
			descEl.textContent = card.dataset.description ?? '';
			dialog.showModal();
			document.documentElement.classList.add('overflow-hidden');
		});
	});

	dialog.addEventListener('close', () => document.documentElement.classList.remove('overflow-hidden'));
	dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});
</script>
